{
  "info": {
    "name": "AURA AWS - QA autenticado",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden con cuentas QA. Crea proveedor y compra de prueba; anula la compra al terminar. No contiene credenciales. Usar environment privado con qaPassword por rol; no publicar tokens ni contrasenas."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://6pkbutuqre.execute-api.us-east-2.amazonaws.com"
    },
    {
      "key": "qaRun",
      "value": "{{$timestamp}}"
    },
    {
      "key": "qaPasswordSolicitante",
      "value": ""
    },
    {
      "key": "qaPasswordGerente",
      "value": ""
    },
    {
      "key": "qaPasswordDirector",
      "value": ""
    },
    {
      "key": "qaPasswordCompras",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01. Login Solicitante",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"solicitante@g7.com\", \"password\": \"{{qaPasswordSolicitante}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200) pm.collectionVariables.set(\"qaTokenSolicitante\",pm.response.json().tokens.accessToken);"
            ]
          }
        }
      ]
    },
