      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const compraResponse = pm.response.json();",
              "pm.test('Identificador', () => pm.expect(compraResponse.id).to.eql(pm.environment.get('solicitud999')));",
              "})();"
            ]
          }
        }
      ]
    },
    {
