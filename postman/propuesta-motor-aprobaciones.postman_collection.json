{
  "info": {
    "name": "PROPUESTA FUTURA - Motor de aprobaciones (demo independiente)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "NO compatible con la API actual de compras-g7. Referencia para integrar el motor de aprobacion. Probada solamente en la demo independiente con SQLite."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    }
  ],
  "item": [
    {
      "name": "01 Salud",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const compraResponse = pm.response.json();",
              "pm.test('Servidor disponible', () => pm.expect(compraResponse.status).to.eql('ok'));",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "Crear 99999 centavos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Dev-User",
            "value": "solicitante"
          }
        ],
        "url": "{{baseUrl}}/api/solicitudes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"descripcion\": \"Licencias de desarrollo\",\n  \"proveedor\": \"Proveedor demo\",\n  \"items\": [\n    {\n      \"descripcion\": \"Licencia\",\n      \"cantidad\": 1,\n      \"precioUnitarioCentavos\": 99999\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const compraResponse = pm.response.json();",
              "pm.test('Total calculado', () => pm.expect(compraResponse.totalCentavos).to.eql(99999));",
              "pm.test('Borrador', () => pm.expect(compraResponse.estado).to.eql('BORRADOR'));",
              "if(pm.response.code === 201) pm.environment.set('solicitud999', compraResponse.id);",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "Consultar 99999",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Dev-User",
