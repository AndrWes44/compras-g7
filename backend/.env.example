# Plantilla sin contrasenas ni claves AWS. Copiar a .env solo si no existe.
AWS_REGION=us-east-2
COGNITO_USER_POOL_ID=us-east-2_REEMPLAZAR
COGNITO_APP_CLIENT_ID=REEMPLAZAR
STATE_MACHINE_ARN=arn:aws:states:us-east-2:000000000000:stateMachine:REEMPLAZAR
DYNAMODB_TABLE=g7-dev-solicitudes
FRONTEND_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
HOST=127.0.0.1
PORT=3000
# En Lambda no definir AWS_PROFILE: usar el rol de ejecucion.
# Para desarrollo local seleccionar un perfil existente desde la terminal.
